#!/bin/sh
# 푸시하는 브랜치 이름과 새 커밋 메시지에 생성 도구 흔적이 있으면 푸시를 막는다.
. "$(dirname "$0")/_patterns.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if echo "$remote_ref" | grep -Eq "$TRACE_RE"; then
    echo "pre-push: 브랜치 이름에 금지된 흔적이 있다: $remote_ref" >&2
    status=1
  fi
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %B' "$range" --not --remotes 2>/dev/null | grep -E "$TRACE_RE")
  if [ -n "$bad" ]; then
    echo "pre-push: 커밋 메시지에 금지된 흔적이 있다:" >&2
    echo "$bad" >&2
    status=1
  fi
done
exit $status
